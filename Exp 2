queue = []

while True:
    print("\n1. Book Ticket")
    print("2. Serve Customer")
    print("3. Display Queue")
    print("4. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        name = input("Enter customer name: ")
        queue.append(name)
        print("Customer added to queue")

    elif ch == 2:
        if not queue:
            print("Queue is empty")
        else:
            print("Ticket booked for:", queue.pop(0))

    elif ch == 3:
        print("Queue:", queue)

    elif ch == 4:
        break

    else:
        print("Invalid choice")
