class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

head = None

def insert_begin(book):
    global head
    new = Node(book)
    new.next = head
    head = new

def insert_end(book):
    global head
    new = Node(book)
    if head is None:
        head = new
        return
    temp = head
    while temp.next:
        temp = temp.next
    temp.next = new

def delete_begin():
    global head
    if head is None:
        print("List is empty")
    else:
        print("Deleted:", head.data)
        head = head.next

def display():
    temp = head
    while temp:
        print(temp.data, end=" -> ")
        temp = temp.next
    print("None")

while True:
    print("\n1. Insert at beginning")
    print("2. Insert at end")
    print("3. Delete from beginning")
    print("4. Display")
    print("5. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        book = input("Enter book name: ")
        insert_begin(book)
    elif ch == 2:
        book = input("Enter book name: ")
        insert_end(book)
    elif ch == 3:
        delete_begin()
    elif ch == 4:
        display()
    elif ch == 5:
        break
    else:
        print("Invalid choice")
