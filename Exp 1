stack = []

while True:
    print("\n1. Return Book")
    print("2. Issue Book")
    print("3. Display Returned Books")
    print("4. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        book = input("Enter book name: ")
        stack.append(book)
        print("Book returned successfully")

    elif ch == 2:
        if not stack:
            print("No books to issue")
        else:
            print("Book issued:", stack.pop())

    elif ch == 3:
        print("Returned books:", stack)

    elif ch == 4:
        break

    else:
        print("Invalid choice")
