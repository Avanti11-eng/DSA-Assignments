class Node:
    def __init__(self, adm_no, name):
        self.adm_no = adm_no
        self.name = name
        self.left = None
        self.right = None

def insert(root, adm_no, name):
    if root is None:
        return Node(adm_no, name)

    if adm_no < root.adm_no:
        root.left = insert(root.left, adm_no, name)
    else:
        root.right = insert(root.right, adm_no, name)

    return root

def inorder(root):
    if root:
        inorder(root.left)
        print(root.adm_no, root.name)
        inorder(root.right)

