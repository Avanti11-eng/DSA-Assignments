class Node:
    def __init__(self, book):
        self.book = book
        self.left = None
        self.right = None

# Create library catalog
root = Node("Python")
root.left = Node("C Programming")
root.right = Node("Java")
root.left.left = Node("Data Structures")
root.left.right = Node("DBMS")
root.right.left = Node("Web Development")
root.right.right = Node("AI")

def display(root):
    if root:
        print(root.book)
        display(root.left)
        display(root.right)

print("Library Catalog:")
display(root)
